with "config/example_config.gpr";
with "pico_bsp.gpr";
with "../glyph.gpr";

project Example is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Example_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("example.adb");

   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-cortex-m0p";

   package Linker is
      for Switches ("Ada") use Pico_BSP.Linker_Switches & (
                                                           "-Wl,--defsym,__heap_start=0",
                                                           "-Wl,--defsym,__heap_end=0"
                                                          );
   end Linker;

   package Compiler is
      for Default_Switches ("Ada") use Example_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Example;
