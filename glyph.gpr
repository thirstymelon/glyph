project Glyph is

   for Source_Dirs use ("src", "src/canvas", "src/display", "src/pixel_formats", "src/transport", "src/controllers", "src/framebuffer");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";

   package Compiler is
      for Default_Switches ("Ada") use
        (
         "-gnat2022",
         "-gnatwa",
         "-gnatf"
        );
   end Compiler;

end Glyph;
