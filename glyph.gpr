project Glyph is

   for Source_Dirs use
     (
      "src",
      "src/canvas",
      "src/pixel_formats",
      "src/controllers",
      "src/framebuffer",
      "src/transport",
      "src/displays"
     );

   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";

   package Compiler is
      for Default_Switches ("Ada") use
        (
         "-gnat2022",
         "-gnatwa",
         "-gnatwJ",
         "-gnatw.X",
         "-gnatf"
        );
   end Compiler;

end Glyph;
