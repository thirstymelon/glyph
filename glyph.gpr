with "config/glyph_config.gpr";

project Glyph is

   type Target_Kind is ("embedded", "desktop");
   Target : Target_Kind := external ("GLYPH_TARGET", "embedded");

   case Target is
      when "embedded" =>
         for Source_Dirs use
           ("src",
            "src/algorithms",
            "src/canvas",
            "src/canvas/c128x64_mono",
            "src/canvas/generic_mono",
            "src/canvas/generic_rgb565",
            "src/canvas/c240x320_rgb565",
            "src/controllers",
            "src/controllers/ili9341",
            "src/display",
            "src/display/ssd1306",
            "src/display/ili9341",
            "src/fonts",
            "src/transport",
            "src/transport/i2c",
            "src/transport/spi");
      when "desktop" =>
         for Source_Dirs use ("src/**");
   end case;

   for Object_Dir use "build/obj";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnatwa",
         "-gnatwJ",
         "-gnatw.X",
         "-gnatf");
   end Compiler;

end Glyph;

