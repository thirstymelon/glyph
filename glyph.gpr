library project Glyph is

   for Source_Dirs use ("src/**");
   for Library_Name use "glyph";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("ada") use
        ("-gnat2022",          --  Ada 2022
         "-gnatwa",            --  All warnings
         "-gnatw.X",           --  No obsolescent feature warnings
         "-gnatf",             --  Full error information
         "-gnatn",             --  Enable inline expansion
         "-O2",                --  Optimization level 2
         "-gnatp");            --  Suppress checks for runtime (production)
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use
        ("-E");                --  No environment variables in executable
   end Binder;

   for Library_Auto_Init use "false";
   for Runtime ("ada") use "default";

end Glyph;
