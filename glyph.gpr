with "pico_bsp.gpr";

library project Glyph is

   for Source_Dirs use
     ("src/**");

   for Object_Dir use "build/obj";
   for Library_Dir use "build/lib";
   for Library_Name use "glyph";
   for Library_Kind use "static";

   for Target use "arm-eabi";

   for Runtime ("Ada") use
     "light-cortex-m0p";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnatwa",
         "-gnatwJ",
         "-gnatw.X",
         "-gnatf");
   end Compiler;

end Glyph;
