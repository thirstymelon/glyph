--  glyph.gpr
--
--  Glyph: Embedded Graphics Framework for Ada
--  GNAT Project file for building the Glyph library.
--
--  Build mode is selected via the GLYPH_BUILD_MODE external variable:
--    debug   - Development build with full runtime checks
--    release - Production build with optimization and checks suppressed
--
--  Copyright (c) 2026 Glyph Contributors
--  Distributed under the Apache License, Version 2.0. See LICENSE.

library project Glyph is

   for Source_Dirs use ("src/**");
   for Library_Name use "glyph";
   for Library_Kind use "static";
   for Library_Auto_Init use "false";

   --  Set by Alire based on the active build profile defined in alire.toml.
   --  `alr build` sets this to "debug" for development, "release" for default.
   Build_Mode : External ("GLYPH_BUILD_MODE", "release");

   package Compiler is
      for Default_Switches ("ada") use
        ("-gnat2022",          --  Ada 2022
         "-gnatwa",            --  All warnings
         "-gnatw.X",           --  Suppress warnings for obsolescent features
         "-gnatf");            --  Full error information

      case Build_Mode is
         when "debug" =>
            for Default_Switches ("ada") use
              Default_Switches ("ada") &
              ("-O0",           --  No optimization
               "-g",            --  Debug symbols
               "-gnato",        --  Overflow checks enabled
               "-gnata",        --  Assertion checks enabled
               "-gnateE");      --  Extra strictness

         when others =>
            for Default_Switches ("ada") use
              Default_Switches ("ada") &
              ("-O2",           --  Optimize for speed
               "-gnatp",        --  Suppress runtime checks
               "-gnatn",        --  Enable inlining
               "-gnatN");       --  Full inlining
      end case;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use
        ("-E");                --  No environment variables in executable
   end Binder;

end Glyph;
