with "config/glyph_example_config.gpr";
with "pico_bsp.gpr";
with "glyph.gpr";

project Glyph_Example is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Glyph_Example_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("glyph_example.adb");

   for Target use "arm-eabi";
    for Runtime ("Ada") use "light-cortex-m0p";

    package Linker is
        for Switches ("Ada") use Pico_BSP.Linker_Switches;
    end Linker;

   package Compiler is
      for Default_Switches ("Ada") use Glyph_Example_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Glyph_Example;
